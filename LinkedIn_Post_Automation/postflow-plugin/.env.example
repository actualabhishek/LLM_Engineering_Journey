# Copy this file to .env in the postflow-plugin/ directory (or export these
# as real environment variables) before using /postflow.

# --- Airtable ---
# Base + table created by setup: "LinkedIn PostFlow" / "Posts"
AIRTABLE_BASE_ID=app2FBJB0YQw5GcV4
AIRTABLE_TABLE_ID=tblJS8x1EWQHp5ZvY

# --- OpenRouter (image generation, routes to a Gemini image model) ---
# Key from https://openrouter.ai/settings/keys — bills per image on your
# OpenRouter account, no Google Cloud billing needed.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Cloudinary (image hosting for Airtable + LinkedIn upload) ---
# Either the single combined URL...
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or the three parts separately (used if CLOUDINARY_URL is unset):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=postflow

# --- Telegram ---
# The telegram plugin itself reads its bot token from
# ~/.claude/channels/telegram/.env (set via /telegram:configure).
# Nothing Telegram-specific is needed here.
