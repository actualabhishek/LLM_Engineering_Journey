# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Models (optional — defaults shown) ───────────────────────────────────────
GRADER_MODEL=claude-haiku-4-5
GENERATOR_MODEL=claude-opus-4-8

# ── Retrieval (optional) ──────────────────────────────────────────────────────
TOP_K=5
MAX_RETRIES=2

# ── Chunking (optional) ───────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ── Paths (optional) ──────────────────────────────────────────────────────────
PARSED_DIR=parsed
CHROMA_DIR=chroma_db
COLLECTION_NAME=rag_kb

# ── Embeddings (optional) ─────────────────────────────────────────────────────
# Uses sentence-transformers locally — no API key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2
