# ============================================================
# ForexAI Trader - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ---- AI Provider API Keys (use only what you need) ----
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ---- MT5 Credentials ----
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server_name

# ---- Webhook Security ----
WEBHOOK_SECRET_TOKEN=generate_a_strong_random_secret_here

# ---- News API (optional, for enhanced news filtering) ----
NEWS_API_KEY=your_newsapi_key_here

# ---- Redis (optional, only if using Redis caching) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Dashboard Auth (optional) ----
DASHBOARD_PASSWORD=your_dashboard_password

# ---- System ----
ENVIRONMENT=production
LOG_LEVEL=INFO
